/* ═══════════════════════════════════════════════════════════
   FIXED NAVBAR — Bulletproof Setup
   ═══════════════════════════════════════════════════════════ */

/* Prevent overflow issues that break sticky/fixed */
html {
  overflow-x: hidden;
  overflow-y: scroll;
}

body {
  overflow-x: hidden;
  position: relative;
  /* Ensure body doesn't create stacking context issues */
  isolation: isolate;
}

/* Ensure no transform on body */
body {
  transform: none !important;
}

/* Fixed navbar — highest priority */
.navbar-fixed-wrapper {
  position: fixed !important;
  top: 0 !important;
  left: 0 !important;
  right: 0 !important;
  width: 100% !important;
  z-index: 9999 !important;
}

/* Prevent layout shift when modals open */
body.modal-open {
  overflow: hidden;
  padding-right: var(--scrollbar-width, 0);
}

/* Navbar animations */
@keyframes slideIn {
  from {
    transform: translateX(100%);
    opacity: 0;
  }
  to {
    transform: translateX(0);
    opacity: 1;
  }
}

.animate-slideIn {
  animation: slideIn 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

/* Ensure content doesn't hide under navbar */
.tz-main-content {
  padding-top: env(safe-area-inset-top, 0);
}

/* Safe area for iPhone notch */
@supports (padding: env(safe-area-inset-top)) {
  .navbar-fixed-wrapper {
    padding-top: env(safe-area-inset-top);
  }
}


/* ═══════════════════════════════════════════════════════════════
   🎨 TAZKIA — Green Buttons Keep, Dark Everything Else
   Rules:
   ✅ Buttons with bg-primary → KEEP green
   ✅ Button hover states → KEEP green
   🎨 All backgrounds/cards/sections → DARK
   ═══════════════════════════════════════════════════════════════ */

/* ─────────────────────────────────────────────
   1. HERO GRADIENT — Green → Dark
   ───────────────────────────────────────────── */
.hero-gradient {
  background: linear-gradient(
    135deg,
    #0B1220 0%,
    #111A2E 25%,
    #0F172A 50%,
    #1A2540 75%,
    #0B1220 100%
  ) !important;
  background-size: 300% 300% !important;
  animation: heroGradient 15s ease infinite !important;
}

