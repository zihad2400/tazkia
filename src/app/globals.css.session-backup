}

/* Silent letters — subtle */
.tajweed-h,
.tajweed-s,
.tajweed-l {
  opacity: 0.65;
}

/* Madda — bold for emphasis */
.tajweed-n,
.tajweed-p,
.tajweed-m {
  font-weight: 600;
}

/* Qalqalah — bold */
.tajweed-q,
.tajweed-o {
  font-weight: 600;
}

/* Ghunnah — medium */
