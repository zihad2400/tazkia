  font-weight: 500;
}

/* Ikhfa — normal */
.tajweed-f,
.tajweed-w {
  font-weight: 500;
}

/* Idgham — medium */
.tajweed-a,
.tajweed-u,
.tajweed-i {
  font-weight: 500;
}

/* Iqlab */
.tajweed-b,
.tajweed-c {
