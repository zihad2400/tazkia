/* ═══════════════════════════════════════════════════════════
   HERO SECTION — Advanced Animations
   ═══════════════════════════════════════════════════════════ */

/* ─── Gradient Background Animation ─── */
@keyframes heroGradient {
  0%, 100% {
    background-position: 0% 50%;
  }
  50% {
    background-position: 100% 50%;
  }
}

.hero-gradient {
  background: linear-gradient(
    135deg,
    #0F5132 0%,
    #0A3B24 25%,
    #0F5132 50%,
    #166B42 75%,
    #0F5132 100%
  );
  background-size: 300% 300%;
  animation: heroGradient 15s ease infinite;
}

/* ─── Floating Orbs ─── */
@keyframes floatOrb1 {
  0%, 100% { transform: translate(0, 0) scale(1); }
  33% { transform: translate(40px, -30px) scale(1.1); }
  66% { transform: translate(-30px, 20px) scale(0.95); }
}

@keyframes floatOrb2 {
  0%, 100% { transform: translate(0, 0) scale(1); }
  50% { transform: translate(-50px, 40px) scale(1.15); }
}

@keyframes floatOrb3 {
  0%, 100% { transform: translate(0, 0) scale(1); }
  50% { transform: translate(30px, 50px) scale(0.9); }
}

.hero-orb-1 { animation: floatOrb1 18s ease-in-out infinite; }
.hero-orb-2 { animation: floatOrb2 22s ease-in-out infinite; }
.hero-orb-3 { animation: floatOrb3 20s ease-in-out infinite; }

/* ─── Rotating Islamic Pattern ─── */
@keyframes rotatePattern {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.hero-pattern-rotate {
  animation: rotatePattern 120s linear infinite;
}

/* ─── Star Twinkle ─── */
@keyframes starTwinkle {
  0%, 100% { opacity: 0.2; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1.2); }
}

.hero-star {
  animation: starTwinkle 4s ease-in-out infinite;
}

/* ─── Fade In Up ─── */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.hero-fade-up {
  animation: fadeInUp 0.8s ease-out forwards;
}

.hero-delay-1 { animation-delay: 0.2s; opacity: 0; }
.hero-delay-2 { animation-delay: 0.4s; opacity: 0; }
.hero-delay-3 { animation-delay: 0.6s; opacity: 0; }
.hero-delay-4 { animation-delay: 0.8s; opacity: 0; }

/* ─── Pulse Ring for Prayer ─── */
@keyframes pulseRing {
  0% { box-shadow: 0 0 0 0 rgba(201, 162, 39, 0.5); }
  70% { box-shadow: 0 0 0 20px rgba(201, 162, 39, 0); }
  100% { box-shadow: 0 0 0 0 rgba(201, 162, 39, 0); }
}

.hero-pulse-ring {
  animation: pulseRing 2.5s infinite;
}

/* ─── Gradient Text ─── */
.hero-gradient-text {
  background: linear-gradient(135deg, #FFD966 0%, #C9A227 50%, #FFD966 100%);
  background-size: 200% 200%;
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  animation: heroGradient 4s ease infinite;
}

/* ─── Button Shine ─── */
@keyframes buttonShine {
  0% { left: -100%; }
  50%, 100% { left: 200%; }
}

.hero-btn-shine {
  position: relative;
  overflow: hidden;
}

.hero-btn-shine::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 60%;
  height: 100%;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(255, 255, 255, 0.4),
    transparent
  );
  animation: buttonShine 3s ease-in-out infinite;
}

/* ─── Arabic Glow ─── */
@keyframes arabicGlow {
  0%, 100% {
    text-shadow: 0 0 20px rgba(201, 162, 39, 0.4);
  }
  50% {
    text-shadow: 0 0 30px rgba(201, 162, 39, 0.8), 0 0 40px rgba(201, 162, 39, 0.4);
  }
}

.hero-arabic-glow {
  animation: arabicGlow 3s ease-in-out infinite;
}

/* ─── Scroll Indicator ─── */
@keyframes scrollBounce {
  0%, 100% { transform: translateY(0); opacity: 1; }
  50% { transform: translateY(8px); opacity: 0.5; }
}

.hero-scroll-indicator {
  animation: scrollBounce 2s ease-in-out infinite;
}

/* ─── Islamic Geometric Pattern Background ─── */
.islamic-geometric-bg {
  background-image:
    /* 8-pointed stars */
    radial-gradient(circle at 20% 20%, rgba(201, 162, 39, 0.08) 0%, transparent 30%),
    radial-gradient(circle at 80% 30%, rgba(201, 162, 39, 0.06) 0%, transparent 30%),
    radial-gradient(circle at 50% 80%, rgba(201, 162, 39, 0.08) 0%, transparent 30%),
    /* Grid lines */
    linear-gradient(45deg, transparent 47%, rgba(201, 162, 39, 0.03) 47%, rgba(201, 162, 39, 0.03) 53%, transparent 53%),
    linear-gradient(-45deg, transparent 47%, rgba(201, 162, 39, 0.03) 47%, rgba(201, 162, 39, 0.03) 53%, transparent 53%);
  background-size: 100% 100%, 100% 100%, 100% 100%, 80px 80px, 80px 80px;
}

/* ─── Glass Card ─── */
.hero-glass {
  background: rgba(255, 255, 255, 0.08);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.15);
}

[data-theme='tazkiaDark'] .hero-glass {
  background: rgba(0, 0, 0, 0.2);
  border-color: rgba(201, 162, 39, 0.2);
}

/* ─── Mobile adjustments ─── */
@media (max-width: 640px) {
  .hero-arabic-glow {
    text-shadow: 0 0 15px rgba(201, 162, 39, 0.5);
  }
}

/* ─── Reduced Motion ─── */
@media (prefers-reduced-motion: reduce) {
  .hero-gradient,
  .hero-orb-1,
  .hero-orb-2,
  .hero-orb-3,
  .hero-pattern-rotate,
  .hero-star,
  .hero-pulse-ring,
  .hero-gradient-text,
  .hero-arabic-glow,
  .hero-scroll-indicator {
    animation: none !important;
  }
}

