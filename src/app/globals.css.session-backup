   2. ALL GRADIENT BACKGROUNDS → Dark
   (Exception: buttons)
   ───────────────────────────────────────────── */
[class*="from-primary"][class*="via-primary-dark"]:not(button):not(a):not(.btn),
[class*="from-primary"][class*="to-primary-dark"]:not(button):not(a):not(.btn),
[class*="from-primary"][class*="via-primary"]:not(button):not(a):not(.btn),
[class*="from-emerald"][class*="to-teal"]:not(button):not(a):not(.btn),
