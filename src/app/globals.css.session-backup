/* ═══════════════════════════════════════════════════════════
   HADITH SECTION — FULL RESPONSIVE
   ═══════════════════════════════════════════════════════════ */

/* Prevent horizontal overflow everywhere */
html, body {
  overflow-x: hidden;
  max-width: 100vw;
}

/* Better text wrapping for long words/URLs */
.hadith-text,
p, h1, h2, h3, h4 {
